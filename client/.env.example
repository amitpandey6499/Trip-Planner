# TripPlanner Client Environment Variables
# Clerk Publishable Key (Get free key at https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API Base URL (Optional when using Vite proxy)
VITE_API_BASE_URL=http://localhost:5000/api

# Mapbox Access Token (Optional - Leaflet interactive OpenStreetMap fallback active by default)
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token
