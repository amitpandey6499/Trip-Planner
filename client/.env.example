# TripPlanner client settings. Copy to `.env` if you need to change anything.

# Leave empty in development: Vite forwards /api to http://localhost:5000 (vite.config.js).
# Set it only when the backend is hosted on a different domain (Part 7, deployment).
VITE_API_BASE_URL=

# Optional Mapbox tiles. Empty = free OpenStreetMap tiles.
VITE_MAPBOX_ACCESS_TOKEN=
