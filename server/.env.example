# ─────────────────────────────────────────────────────────────
# TripPlanner server settings. Copy this file to `.env` and fill it in.
# Values starting with "your_" are treated as NOT set.
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Address(es) of the app, for CORS and share links. Several? separate with commas.
# Empty = Render's own address (RENDER_EXTERNAL_URL, set by Render) or, locally, http://localhost:5173 (Vite).
# With your own domain on Render: CLIENT_URL=https://your-domain.example
CLIENT_URL=http://localhost:5173
# Part 14: the app's public address, used for share links inside PDFs (QR code). Empty = the first CLIENT_URL.
# Set it when you deploy, e.g. PUBLIC_APP_URL=https://tripplanner.example.com
PUBLIC_APP_URL=

# ── Production (Part 18) ────────────────────────────────────
# One service for app + API: in production the server also serves the built React app (client/dist).
# auto = yes when NODE_ENV=production and client/dist exists (run `npm run build` first). true / false to force.
SERVE_CLIENT=auto
# Where the built app is. Empty = ../client/dist
CLIENT_DIST_DIR=
# true behind a hosting proxy (Render, Railway, Nginx): real visitor IPs for the rate limits. false locally.
TRUST_PROXY=false

# ── Database (REQUIRED) ─────────────────────────────────────
# Free MongoDB Atlas cluster: follow docs/SETUP_MONGODB.md
# Example: mongodb+srv://tripuser:YourPassword@cluster0.abcde.mongodb.net/tripplanner?retryWrites=true&w=majority
# Local MongoDB also works: mongodb://127.0.0.1:27017/tripplanner
MONGODB_URI=

# ── Login ───────────────────────────────────────────────────
# Long random text (at least 32 characters). REQUIRED in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# lax works locally and on Render (app + API on one address). Only if you host the API on a different domain
# than the app: none + COOKIE_SECURE=true (Safari may still block such cookies).
COOKIE_SAMESITE=lax
COOKIE_SECURE=auto
# "Try the demo account" button on the login page
DEMO_LOGIN_ENABLED=true
# Part 17: these accounts see the admin dashboard (/admin) after logging in. Comma-separated. Empty = nobody by e-mail
# (you can also run: npm run admin -w server -- add you@example.com). The demo account is never an admin.
ADMIN_EMAILS=

# ── AI ──────────────────────────────────────────────────────
# Google Gemini — free key: https://aistudio.google.com/apikey
# Without a key the offline planner is used (curated real places for 8 destinations:
# Manali, Goa, Jaipur, Udaipur, Varanasi, Kerala, Andaman, Rishikesh).
GEMINI_API_KEY=your_gemini_api_key
# Any model from https://ai.google.dev/gemini-api/docs/models that supports JSON output.
# If Google retires it you get a clear "model not found, change GEMINI_MODEL" message.
GEMINI_MODEL=gemini-3.8-flash
# Gemini calls per user per day (answers from the cache do not count)
AI_DAILY_LIMIT=20
# Give up on one Gemini call after this many seconds (then 1 retry / offline planner)
AI_TIMEOUT_SECONDS=45
# Same request within this many days → answered from the AI cache (Regenerate skips it)
AI_CACHE_DAYS=7

# Google Places (optional)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ── Map: place lookup + road routes (Part 8) ────────────────
# Free OpenStreetMap community services. Their usage policies apply (see docs/MAP_SERVICES.md):
#   Nominatim: https://operations.osmfoundation.org/policies/nominatim/  (max 1 request/second, identify the app, cache)
#   OSRM / FOSSGIS routing: https://map.project-osrm.org/about.html (max 1 request/second, identify the app, attribution)
# The server follows these rules for you (one queue per service, User-Agent, MongoDB cache).
# false = no network calls at all: AI positions are kept and distances are straight-line estimates.
MAP_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional contact e-mail sent to Nominatim with each lookup (recommended by its operators). Leave empty to send none.
NOMINATIM_EMAIL=
OSRM_URL=https://routing.openstreetmap.de/routed-car
# Optional: your own User-Agent text, sent to ALL outside services (map, Wikipedia, Open-Meteo).
# Default: "TripPlanner/<version> (B.Tech mini project, ABESEC; trip planner)". Better: add a contact, e.g.
# GEO_USER_AGENT=TripPlanner/2.0 (https://your-site.example; you@example.com)
GEO_USER_AGENT=
GEO_TIMEOUT_SECONDS=10
GEO_CACHE_DAYS=60

# ── Destination photos (Part 10) ────────────────────────────
# Lead image of each destination's Wikipedia article (free licences only), cached in MongoDB for 30 days.
# Wikimedia asks every API client for an identifying User-Agent (see GEO_USER_AGENT):
#   https://doc.wikimedia.org/generated-data-platform/aqs/analytics-api/documentation/access-policy.html
# false = no photo lookups (cards show a plain placeholder). Refresh by hand: npm run photos -w server
PHOTOS_ENABLED=true
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# ── Weather (Part 11) ───────────────────────────────────────
# Open-Meteo, no key. Free API = NON-COMMERCIAL use only, < 10,000 calls/day; data CC BY 4.0 (credit is shown).
#   https://open-meteo.com/en/terms
# Next 16 days = forecast; later dates = typical weather from the same dates of the last 3 years (archive API).
WEATHER_ENABLED=true
OPEN_METEO_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com

# ── Rate limits ─────────────────────────────────────────────
# Counted per IP address. Everyone in one college lab / hostel WiFi shares one public IP — keep these generous for a demo.
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
AI_RATE_LIMIT_PER_MIN=10
# Map, weather and "how to reach" requests per IP per minute (answers are cached, so repeats are cheap)
MAP_RATE_LIMIT_PER_MIN=60
AUTH_RATE_LIMIT_MAX=20
