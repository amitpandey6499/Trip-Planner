# TripPlanner Server Environment Variables
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tripplanner_db
DB_PORT=3306

# Clerk Authentication (Get keys at https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Google Gemini AI API (Get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Google Places API (Optional - uses verified offline dataset if not provided)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Arcjet Rate Limiting & Bot Protection (Optional - uses express-rate-limit fallback)
ARCJET_KEY=your_arcjet_key
ARCJET_ENV=development

# Client URL (For CORS)
CLIENT_URL=http://localhost:5173
