# ─────────────────────────────────────────────────────────────
# TripPlanner server settings. Copy this file to `.env` and fill it in.
# Values starting with "your_" are treated as NOT set.
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL(s) allowed by CORS. Several? separate with commas.
CLIENT_URL=http://localhost:5173

# Google Gemini AI — free key: https://aistudio.google.com/apikey
# Without a key the app uses offline sample itineraries.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Google Places (optional)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# MySQL (optional, replaced by MongoDB in Part 3). Set MYSQL_ENABLED=false to skip it.
MYSQL_ENABLED=true
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tripplanner_db
DB_PORT=3306

# Rate limits
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_PER_MIN=10
