{
  "name": "tripplanner-server",
  "version": "1.1.0",
  "description": "Backend API for TripPlanner (Express + MongoDB + Gemini AI)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
