    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.0",
    "morgan": "^1.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^11.3.0",
