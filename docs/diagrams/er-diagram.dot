digraph ER {
graph [rankdir=LR, nodesep=0.3, ranksep=0.9, pad=0.15, dpi=300, bgcolor=white];
node [shape=plain, fontname="Liberation Sans"];
edge [color="#5a5a5a", penwidth=1.5, fontname="Liberation Sans", fontsize=13, dir=both, arrowsize=0.9];
User [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#0f4c5c"><FONT COLOR="white" POINT-SIZE="16"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">name</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">email  (unique)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">passwordHash</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">role  (user / admin)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">isDemo</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">favorites  [destination slugs]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">lastLoginAt</FONT></TD></TR></TABLE>>];
Trip [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#14807a"><FONT COLOR="white" POINT-SIZE="16"><B>Trip</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">owner  (FK → User)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">title, destination</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">startDate, endDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">travelersCount</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">totalBudget, budgetCategory</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">preferences  { … }</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">itinerary  { days, hotels, restaurants, budget }</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">share  { enabled, slug, views }</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">members  [ { id, name } ]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">packingChecked  [ ]</FONT></TD></TR></TABLE>>];
Expense [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#c9962c"><FONT COLOR="white" POINT-SIZE="16"><B>Expense</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">trip  (FK → Trip)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">owner  (FK → User)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">kind  (expense / settlement)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">description, category, date</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">amountPaise</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">paidBy  (member id)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">split  { mode, shares }</FONT></TD></TR></TABLE>>];
Destination [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#8e3b46"><FONT COLOR="white" POINT-SIZE="16"><B>Destination</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">slug  (unique)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">name, state</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">categories, interests</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">bestMonths, idealDays</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">dailyBudget, center</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">reach, stays, eateries</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">photo</FONT></TD></TR></TABLE>>];
ContactMessage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#5a5a5a"><FONT COLOR="white" POINT-SIZE="16"><B>ContactMessage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">user  (FK → User, optional)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">name, email</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">message</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">status  (new / read)</FONT></TD></TR></TABLE>>];
AiUsage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#5a5a5a"><FONT COLOR="white" POINT-SIZE="16"><B>AiUsage</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">user  (FK → User)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">day</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">count</FONT></TD></TR></TABLE>>];
AiCache [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#5a5a5a"><FONT COLOR="white" POINT-SIZE="16"><B>AiCache</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">key</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">model</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">itinerary</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">hits</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">expiresAt  (TTL: deleted automatically)</FONT></TD></TR></TABLE>>];
GeoCache [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#5a5a5a"><FONT COLOR="white" POINT-SIZE="16"><B>GeoCache</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">_id  (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">key</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">kind  (place / route / weather)</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">data</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="13">expiresAt  (TTL: deleted automatically)</FONT></TD></TR></TABLE>>];
User -> Trip [label="owns\n1 : N", arrowtail=tee, arrowhead=crow];
Trip -> Expense [label="has\n1 : N", arrowtail=tee, arrowhead=crow];
User -> Expense [label="records\n1 : N", arrowtail=tee, arrowhead=crow, constraint=false];
User -> Destination [label="favourites\nM : N", arrowtail=crow, arrowhead=crow];
User -> ContactMessage [label="sends\n0..1 : N", arrowtail=teeodot, arrowhead=crow];
User -> AiUsage [label="AI plans per day\n1 : N", arrowtail=tee, arrowhead=crow];
{rank=same; Expense; AiCache; GeoCache}
Expense -> AiCache [style=invis]; AiCache -> GeoCache [style=invis];
}